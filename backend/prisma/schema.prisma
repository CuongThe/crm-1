// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
  NO_SHOW
}

model User {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  email         String           @unique @db.VarChar(150)
  passwordHash  String           @map("password_hash") @db.VarChar(255)
  fullName      String           @map("full_name") @db.VarChar(100)
  phone         String?          @db.VarChar(20)
  role          Role             @default(STAFF)
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  services         StaffService[]
  appointments     Appointment[]
  appointmentLogs  AppointmentLog[]

  @@map("users")
}

model Customer {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  fullName    String       @map("full_name") @db.VarChar(100)
  phone       String       @unique @db.VarChar(20)
  email       String?      @db.VarChar(150)
  gender      Gender       @default(OTHER)
  dob         DateTime?    @db.Date
  notes       String?      @db.Text
  totalSpent  Decimal      @default(0.00) @map("total_spent") @db.Decimal(12, 2)
  visitCount  Int          @default(0) @map("visit_count") @db.UnsignedInt
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // Relations
  appointments Appointment[]

  @@index([phone], map: "idx_customers_phone")
  @@index([fullName], map: "idx_customers_name")
  @@map("customers")
}

model Service {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name            String         @db.VarChar(150)
  description     String?        @db.Text
  price           Decimal        @default(0.00) @db.Decimal(12, 2)
  durationMinutes Int            @default(30) @map("duration_minutes") @db.UnsignedInt
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  staffs          StaffService[]
  appointments    Appointment[]

  @@map("services")
}

model StaffService {
  userId    BigInt  @map("user_id") @db.UnsignedBigInt
  serviceId BigInt  @map("service_id") @db.UnsignedBigInt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([userId, serviceId])
  @@map("staff_services")
}

model Appointment {
  id          BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  customerId  BigInt            @map("customer_id") @db.UnsignedBigInt
  staffId     BigInt            @map("staff_id") @db.UnsignedBigInt
  serviceId   BigInt            @map("service_id") @db.UnsignedBigInt
  startTime   DateTime          @map("start_time")
  endTime     DateTime          @map("end_time")
  status      AppointmentStatus @default(PENDING)
  price       Decimal           @default(0.00) @db.Decimal(12, 2)
  notes       String?           @db.VarChar(500)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  // Relations
  customer Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  staff    User             @relation(fields: [staffId], references: [id], onDelete: Restrict)
  service  Service          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  logs     AppointmentLog[]

  @@index([staffId, startTime, endTime], map: "idx_staff_schedule")
  @@index([status, startTime], map: "idx_status_start_time")
  @@index([customerId, startTime], map: "idx_customer_appointments")
  @@map("appointments")
}

model AppointmentLog {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  appointmentId BigInt      @map("appointment_id") @db.UnsignedBigInt
  action        String      @db.VarChar(50)
  note          String?     @db.Text
  createdBy     BigInt?     @map("created_by") @db.UnsignedBigInt
  createdAt     DateTime    @default(now()) @map("created_at")

  // Relations
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  creator     User?       @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@map("appointment_logs")
}